	(text "GPIO kiosztás:\nGPIO23 SPI_MOSI\nGPIO19 SPI_MISO\nGPIO18 SPI_SCK\n\nGPIO22 I2C_SCL\nGPIO21 I2C_SDA\n\nGPIO27 TEMPERATURE_SENSOR_BUS (5× DS18B20)\n\nGPIO26 BOILER_ROOM_TEMPERATURE (DHT11)\n\nGPIO17 DISPLAY1_DC + DISPLAY2_DC\nGPIO16 DISPLAY1_RESET + DISPLAY2_RESET\nGPIO5  DISPLAY1_CS\nGPIO4  DISPLAY2_CS\n\nGPIO14 CHIMNEY_TEMPERATURE_CS (MAX6675)\n\nGPIO25 BUZZER\n\nGPIO32 GAS_AC_PRESENT\nGPIO33 WOOD_AC_PRESENT\n\nGPIO13 MICROSD_CS"
