	(text "GPIO kiosztás:\nGPIO23  -> SPI_MOSI\nGPIO19  -> SPI_MISO\nGPIO18  -> SPI_SCK\n\nGPIO22  -> I2C_SCL\nGPIO21  -> I2C_SDA\n\nGPIO27  -> TEMPERATURE_SENSOR_BUS\n\nGPIO26  -> BOILER_ROOM_TEMPERATURE\n\nGPIO17  -> DISPLAY_DC\nGPIO16  -> DISPLAY_RESET\nGPIO5   -> DISPLAY_CS\n\nGPIO4   -> CHIMNEY_TEMPERATURE_CS\n\nGPIO25  -> BUZZER\n\nGPIO33  -> RELAY_GAS_PUMP\nGPIO32  -> RELAY_WOOD_PUMP\nGPIO13  -> RELAY_GAS_VALVE\nGPIO14  -> RELAY_WOOD_VALVE\nGPIO15  -> RELAY_AUX\n\nGPIO39  -> RESERVED_INPUT_1\nGPIO36  -> RESERVED_INPUT_2\nGPIO35  -> RESERVED_INPUT_3\nGPIO34  -> RESERVED_INPUT_4\n\nGPIO2   -> RESERVED_GPIO_1\nGPIO0   -> RESERVED_GPIO_2\nGPIO12  -> RESERVED_GPIO_3\n\nGPIO1   -> UART_TX0\nGPIO3   -> UART_RX0"
		(exclude_from_sim no)
