	(text "GPIO kiosztás:\nGPIO18 SPI_SCK (Display SCK, T_CLK)\nGPIO19 SPI_MISO (Display SDO, T_DO)\nGPIO23 SPI_MOSI (Display SDI, T_DIN)\n\nGPIO17 DISPLAY_CS\nGPIO16 DISPLAY_DC\nGPIO04 DISPLAY_RESET\nGPIO32 DISPLAY_LED\n\nGPIO27 T_CS\nGPIO34 T_IRQ\n\nGPIO21 I2C_SDA\nGPIO22 I2C_SCL\n\nGPIO35 PHOTORESISTOR\n\nGPIO33 LED_R\nGPIO25 LED_G\nGPIO26 LED_B\n\nGPIO13 BUZZER_2\nGPIO14 BUZZER_1"
